---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Practice from '../components/Practice.astro';
import Band from '../components/Band.astro';
import Lineage from '../components/Lineage.astro';
import Pillars from '../components/Pillars.astro';
import Spaces from '../components/Spaces.astro';
import Cities from '../components/Cities.astro';
import Waitlist from '../components/Waitlist.astro';
---
<Base overHero>
  <Hero />
  <Practice />
  <Band
    photo="outdoor-lounge"
    alt="Members at tables and sofas on a terrace among olive trees, with padel courts beyond, at golden hour"
    caption="The outdoor lounge"
  />
  <Lineage />
  <Pillars />
  <Spaces />
  <Cities />
  <Waitlist />
</Base>
