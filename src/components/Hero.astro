---
import Photo from './Photo.astro';
import { site } from '../site.config';
---
<section class="hero on-dark" id="top" aria-labelledby="hero-title">
  <div class="media" aria-hidden="false">
    <Photo
      name="exterior"
      alt="Mizan club entrance at dusk, framed by olive trees"
      loading="eager"
      fetchpriority="high"
      sizes="100vw"
    />
  </div>
  <div class="shade" aria-hidden="true"></div>

  <div class="content container">
    <p class="pillars eyebrow">{site.pillars.join(' · ')}</p>
    <h1 id="hero-title" class="wordmark">{site.name}</h1>
    <div class="row">
      <p class="tagline">{site.tagline}</p>
      <div class="actions">
        <a class="btn btn-light" href="#waitlist">Join the waitlist <span class="arrow" aria-hidden="true">→</span></a>
        <a class="discover" href="#practice">Discover Mizan</a>
      </div>
    </div>
  </div>

  <div class="foot container">
    <p class="cities">
      {site.cities.map((c, i) => (
        <span>{c.name}{i < site.cities.length - 1 && <i aria-hidden="true">/</i>}</span>
      ))}
    </p>
    <a class="scroll" href="#practice" aria-label="Scroll to the next section">
      <span class="line" aria-hidden="true"></span>
    </a>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: grid;
    grid-template-rows: 1fr auto;
    overflow: hidden;
    isolation: isolate;
  }
  .media {
    position: absolute;
    inset: 0;
    z-index: -2;
  }
  @media (prefers-reduced-motion: no-preference) {
    .media {
      animation: drift 22s var(--ease) both;
    }
  }
  @keyframes drift {
    from { transform: scale(1.12); }
    to { transform: scale(1); }
  }
  .shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(180deg, rgb(20 16 12 / .55) 0%, rgb(20 16 12 / 0) 28%),
      linear-gradient(90deg, rgb(20 16 12 / .45) 0%, rgb(20 16 12 / 0) 55%),
      linear-gradient(0deg, rgb(20 16 12 / .82) 0%, rgb(20 16 12 / .3) 42%, rgb(20 16 12 / 0) 68%);
  }

  .content {
    align-self: end;
    padding-top: calc(var(--header-h) + 48px);
    padding-bottom: clamp(32px, 6vh, 64px);
  }
  .pillars {
    color: rgb(244 239 229 / .78) !important;
    letter-spacing: .3em;
    font-size: clamp(9.5px, 1vw, 11.5px);
  }
  .wordmark {
    margin-top: clamp(14px, 2vw, 22px);
    /* Sized so the wordmark sits below the building's own Mizan sign. */
    font-size: clamp(64px, 11vw, 184px);
    font-weight: 330;
    line-height: .9;
    letter-spacing: .14em;
    text-transform: uppercase;
    /* Optical spacing: the last letter's tracking shouldn't push it off-centre. */
    margin-right: -.14em;
  }
  .tagline {
    margin-top: clamp(14px, 2vw, 24px);
    font-family: var(--serif);
    font-style: italic;
    font-weight: 330;
    font-size: clamp(20px, 2.4vw, 32px);
    color: rgb(244 239 229 / .9);
  }
  .actions {
    margin-top: clamp(28px, 4vw, 44px);
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px 28px;
  }
  /* Desktop: tagline and buttons share a line, so the whole block sits
     lower in the frame and the wordmark clears the building's sign. */
  @media (min-width: 960px) {
    .row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 32px;
    }
    .row .actions { margin-top: clamp(14px, 2vw, 24px); flex-wrap: nowrap; }
  }
  .discover {
    font-size: 12.5px;
    font-weight: 600;
    letter-spacing: .16em;
    text-transform: uppercase;
    text-decoration: none;
    padding-block: 6px;
    border-bottom: 1px solid rgb(244 239 229 / .4);
    transition: border-color .3s;
  }
  .discover:hover { border-color: var(--canvas); }

  .foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding-block: 22px clamp(22px, 4vh, 36px);
    border-top: 1px solid rgb(244 239 229 / .18);
  }
  .cities {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 0;
    font-size: 11.5px;
    font-weight: 500;
    letter-spacing: .22em;
    text-transform: uppercase;
    color: rgb(244 239 229 / .8);
  }
  .cities i {
    font-style: normal;
    margin-inline: 14px;
    color: var(--brass-l);
  }
  .scroll {
    flex: 0 0 auto;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
  }
  .line {
    position: relative;
    width: 1px;
    height: 40px;
    background: rgb(244 239 229 / .3);
    overflow: hidden;
  }
  .line::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--canvas);
    transform: translateY(-100%);
  }
  @media (prefers-reduced-motion: no-preference) {
    .line::after { animation: drip 2.4s var(--ease) infinite; }
  }
  @keyframes drip {
    0% { transform: translateY(-100%); }
    60%, 100% { transform: translateY(100%); }
  }

  @media (max-width: 640px) {
    .cities i { margin-inline: 9px; }
    .cities { font-size: 10px; letter-spacing: .18em; }
    .scroll { display: none; }
  }
</style>
