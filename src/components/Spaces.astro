---
import Photo from './Photo.astro';

const spaces = [
  { photo: 'lounge', wing: 'The social heart', name: 'The Lounge', line: 'Coffee, work, conversation and meals: where members return between everything else.', alt: 'The Lounge, with lounge seating and an all-day kitchen' },
  { photo: 'courts', wing: 'Active wing', name: 'Courts', line: 'Padel for a match, a lesson, a league or simply to play with friends.', alt: 'Indoor padel courts' },
  { photo: 'studio', wing: 'Active wing', name: 'Movement studios', line: 'Pilates and reformer, mobility, yoga and conditioning, coached in small groups.', alt: 'A light-filled movement studio' },
  { photo: 'gym', wing: 'Active wing', name: 'Strength & functional gym', line: 'Built around one objective: keeping the body capable.', alt: 'The strength and functional training gym' },
  { photo: 'wet-recovery', wing: 'Calm wing', name: 'Wet recovery', line: 'Sauna, steam, cold plunges and a heated immersion pool.', alt: 'Sauna and heated pool in wet recovery' },
  { photo: 'hammam', wing: 'Calm wing · Cultural anchor', name: 'The Hammam', line: 'Heat, water and ritual, contemporary in execution and centuries old in spirit.', alt: 'The hammam with heated stone' },
  { photo: 'mizaj-suite', wing: 'Calm wing · Mizaj', name: 'The Mizaj Suite', line: 'Where your measurements become a personal protocol, with your coach.', alt: 'A private consultation room in the Mizaj Suite' },
  { photo: 'dry-recovery', wing: 'Calm wing', name: 'Dry recovery', line: 'Red light, compression, breathwork and bodywork, in a quieter setting.', alt: 'The dry recovery room' },
];
---
<section class="spaces section on-dark" id="spaces" aria-labelledby="spaces-title">
  <div class="container head">
    <div>
      <p class="eyebrow" data-reveal>The club</p>
      <h2 id="spaces-title" class="h2" data-reveal>A place to build your week around.</h2>
    </div>
    <p class="lede" data-reveal>
      Train before work. Recover between meetings. Get measured, meet your coach, and stay for lunch.
    </p>
  </div>

  <div class="rail" data-rail>
    <ul class="track" data-track tabindex="0" aria-label="Spaces at Mizan, scroll sideways">
      {spaces.map((s) => (
        <li class="card">
          <figure>
            <div class="ratio">
              <Photo name={s.photo} alt={s.alt} sizes="(min-width: 960px) 34vw, 82vw" />
            </div>
            <figcaption>
              <span class="wing">{s.wing}</span>
              <span class="name">{s.name}</span>
              <span class="line">{s.line}</span>
            </figcaption>
          </figure>
        </li>
      ))}
    </ul>

    <div class="container controls">
      <div class="progress" aria-hidden="true"><span></span></div>
      <div class="buttons">
        <button type="button" class="nav" data-dir="-1" aria-label="Previous spaces">←</button>
        <button type="button" class="nav" data-dir="1" aria-label="Next spaces">→</button>
      </div>
    </div>
    <p class="container note">Concept renders. Spaces, amenities and programming may vary by location.</p>
  </div>
</section>

<script>
  const rail = document.querySelector<HTMLElement>('[data-rail]');
  const track = rail?.querySelector<HTMLElement>('[data-track]');
  if (rail && track) {
    rail.querySelectorAll<HTMLButtonElement>('button[data-dir]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const card = track.querySelector<HTMLElement>('.card');
        const step = card ? card.getBoundingClientRect().width + 24 : track.clientWidth * 0.8;
        track.scrollBy({ left: step * Number(btn.dataset.dir), behavior: 'smooth' });
      });
    });
  }
</script>

<style>
  .spaces {
    timeline-scope: --rail;
  }
  .head {
    display: grid;
    grid-template-columns: 1.2fr .8fr;
    align-items: end;
    gap: 32px 64px;
  }
  .h2 { margin-top: 22px; }

  .rail {
    margin-top: clamp(48px, 6vw, 80px);
  }
  .track {
    scroll-timeline: --rail x;
    list-style: none;
    margin: 0;
    padding: 0 max(var(--gutter), calc((100vw - var(--max)) / 2 + var(--gutter)));
    display: flex;
    gap: 24px;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: max(var(--gutter), calc((100vw - var(--max)) / 2 + var(--gutter)));
    scrollbar-width: none;
  }
  .track::-webkit-scrollbar { display: none; }
  .track:focus-visible { outline-offset: -2px; }
  .card {
    flex: 0 0 min(82vw, 460px);
    scroll-snap-align: start;
  }
  figure { margin: 0; }
  .ratio {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: 2px;
  }
  .ratio :global(.fill-media) {
    transition: transform 1.2s var(--ease);
  }
  .card:hover .ratio :global(.fill-media) { transform: scale(1.04); }
  figcaption {
    display: grid;
    gap: 8px;
    padding-top: 20px;
    padding-right: 16px;
  }
  .wing {
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: .24em;
    text-transform: uppercase;
    color: var(--brass-l);
  }
  .name {
    font-family: var(--serif);
    font-size: clamp(24px, 2.2vw, 30px);
    font-weight: 360;
  }
  .line {
    color: var(--on-dark-muted);
    font-size: 15px;
    max-width: 26em;
  }

  .controls {
    margin-top: 36px;
    display: flex;
    align-items: center;
    gap: 32px;
  }
  .progress {
    flex: 1;
    height: 1px;
    background: var(--line-dark);
    overflow: hidden;
  }
  .progress span {
    display: block;
    height: 100%;
    background: var(--brass-l);
    transform-origin: left;
    transform: scaleX(.18);
  }
  @supports (animation-timeline: scroll()) {
    .progress span {
      transform: scaleX(0);
      animation-name: progress;
      animation-timing-function: linear;
      animation-fill-mode: both;
      animation-timeline: --rail;
    }
  }
  @keyframes progress {
    from { transform: scaleX(.12); }
    to { transform: scaleX(1); }
  }
  .buttons { display: flex; gap: 10px; }
  .nav {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    border: 1px solid var(--line-dark);
    background: transparent;
    color: var(--canvas);
    font-size: 18px;
    cursor: pointer;
    transition: background-color .3s, color .3s, border-color .3s;
  }
  .nav:hover { background: var(--canvas); color: var(--ink); border-color: var(--canvas); }
  .note {
    margin-top: 28px;
    font-size: 12px;
    color: rgb(244 239 229 / .45);
  }

  @media (max-width: 860px) {
    .head { grid-template-columns: 1fr; }
    .buttons { display: none; }
  }
</style>
